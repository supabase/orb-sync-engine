{
  "name": "orb-sync-node-fastify",
  "version": "0.0.0",
  "description": "Node.js fastify app to sync Orb data to Postgres.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx --watch ./src/server.ts | pino-pretty",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "oxlint src",
    "lint:check": "oxlint src",
    "format": "prettier --write src/**",
    "format:check": "prettier src/**",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "author": "Supabase",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sentry/node": "^10.75.0",
    "dotenv": "^18.0.1",
    "fastify": "^5.12.5",
    "fastify-metrics": "^14.1.0",
    "orb-sync-lib": "*"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "vitest": "5.0.1"
  }
}